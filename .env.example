```env
# ==========================================
# General
# ==========================================

PUID=1000
PGID=1000
TZ=Europe/Zagreb

# Docker application data
APPDATA=/docker/appdata

# ==========================================
# Media
# ==========================================

MEDIA_ROOT=/share_media
DOWNLOADS=/share_media/downloads

TV=/share_media/tv
MOVIES=/share_media/movies
ANIME=/share_media/anime
BOOKS=/share_media/books
COMICS=/share_media/comics
MANGA=/share_media/manga

# ==========================================
# Network
# ==========================================

SERVER_IP=192.168.100.90

# ==========================================
# Homepage
# ==========================================

HOMEPAGE_ALLOWED_HOSTS=homepage.home,192.168.100.90,192.168.100.90:3000,localhost:3000

# Homepage API keys
# Add these only to your real .env
#
# JELLYFIN_API_KEY=
# SONARR_API_KEY=
# RADARR_API_KEY=
# PROWLARR_API_KEY=
# etc.

# ==========================================
# Beszel
# ==========================================

BESZEL_LISTEN=45876
BESZEL_AGENT_KEY=REPLACE_WITH_YOUR_BESZEL_AGENT_KEY
BESZEL_HUB_URL=http://${SERVER_IP}:8090
BESZEL_HWMON_PATH=/sys/class/hwmon/hwmon1
BESZEL_CPU_TEMP_PATH=/sys/class/hwmon/hwmon*/temp1_input
BESZEL_NET_INTERFACE=eno1

# ==========================================
# WireGuard
# ==========================================

SERVERURL=REPLACE_WITH_YOUR_PUBLIC_IP_OR_DOMAIN
SERVERPORT=51820
```
